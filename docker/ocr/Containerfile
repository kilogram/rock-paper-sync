# OCR Service Container for TrOCR inference and fine-tuning
#
# BASE IMAGE REQUIREMENTS:
#   - Python 3.10+ (as `python` in PATH)
#   - PyTorch 2.1+ with appropriate backend (ROCm, CUDA, or CPU)
#   - uv package manager (in PATH)
#
# Build examples:
#   podman build --build-arg BASE_IMAGE=localhost/ml-base-rocm:latest -t ocr:rocm .
#   podman build --build-arg BASE_IMAGE=docker.io/pytorch/pytorch:2.1.0-cuda12.1-cudnn8-runtime -t ocr:cuda .
#   podman build --build-arg BASE_IMAGE=localhost/ml-base-cpu:latest -t ocr:cpu .

ARG BASE_IMAGE=docker.io/python:3.12-slim
FROM ${BASE_IMAGE}

# Common environment
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
# Models cached in mounted volume at runtime
ENV TRANSFORMERS_CACHE=/app/models
ENV HF_HOME=/app/models
ENV HF_DATASETS_CACHE=/app/data

WORKDIR /app

# Install dependencies into base image's Python environment
# (ROCm base uses /opt/venv which already has PyTorch with GPU support)
COPY requirements.txt .
RUN uv pip install --no-cache -r requirements.txt

# Models downloaded at first run into mounted /app/models volume
# This allows sharing cache between container rebuilds

# Copy service code
COPY src/ocr_service /app/ocr_service

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=5)" || exit 1

ENTRYPOINT ["python", "-m", "ocr_service"]
CMD ["serverless"]
